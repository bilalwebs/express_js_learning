<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Students</title>
  </head>
  <body>
    <h1>Studnets</h1>
    <table border="1">
        <tr>
            <td>Name</td>
            <td>Age</td>
            <td>Email</td>
        </tr>
        <% students.forEach(std=>{%>
            <tr>
            <td><%=std.name%></td>
            <td><%=std.age%></td>
            <td><%=std.email%></td>
        </tr>

       <% }) %>
    </table>
  </body>
</html>
