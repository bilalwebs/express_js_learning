<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update Student</title>
  </head>
  <body>
    <form action="/ui/update/<%=result._id%>" method="post">
      <input
        type="text"
        placeholder="enter user name"
        name="name"
        value="<%= result.name%>"
      />
      <br /><br />
      <input
        type="text"
        placeholder="enter email"
        name="email"
        value="<%= result.email%>"
      />
      <br /><br />
      <input
        type="text"
        placeholder="enter age"
        name="age"
        value="<%= result.age%>"
      />
      <br /><br />
      <button type="">Update Studnt</button>
    </form>
  </body>
</html>
